{
  "name": "saludeimagendelpuerto",
  "compatibility_date": "2026-10-03",
  "main": "./frontend/server/worker.js",
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/content",
      "/",
      "/es",
      "/es/*",
      "/en",
      "/en/*",
      "/servicios",
      "/servicios/*",
      "/prevencion",
      "/nosotros",
      "/contacto",
      "/aviso-de-privacidad",
      "/terminos-y-condiciones",
      "/robots.txt",
      "/sitemap.xml",
    ],
    "not_found_handling": "single-page-application",
  },
}
